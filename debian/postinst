#!/bin/sh
set -e

if [ "$1" = "configure" ]; then
    ldconfig
    # Ensure virtualenv python points to system python3 on target machine
    SYS_PY=$(command -v python3.13 || command -v python3 || true)
    if [ -n "$SYS_PY" ] && [ -d "/opt/fingerswipe/bin" ]; then
        ln -sf "$SYS_PY" /opt/fingerswipe/bin/python
        ln -sf python /opt/fingerswipe/bin/python3
        ln -sf python /opt/fingerswipe/bin/python3.13
    fi
    # Reload udev rules and trigger for input subsystem
    if [ -x "$(command -v udevadm)" ]; then
        udevadm control --reload-rules || true
        udevadm trigger --subsystem-match=input || true
    fi
    # Reload systemd user daemon and enable/start the service for active user sessions
    for user in $(loginctl list-users --no-legend | awk '{print $2}'); do
        uid=$(id -u "$user")
        sudo -u "$user" XDG_RUNTIME_DIR=/run/user/$uid DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/$uid/bus systemctl --user daemon-reload || true
        sudo -u "$user" XDG_RUNTIME_DIR=/run/user/$uid DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/$uid/bus systemctl --user enable fingerswipe.service || true
        sudo -u "$user" XDG_RUNTIME_DIR=/run/user/$uid DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/$uid/bus systemctl --user restart fingerswipe.service || true
    done
fi

#DEBHELPER#
exit 0
